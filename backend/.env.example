# ============================================================================
# PRICEHUNT ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env and configure your secrets and credentials.
# NEVER commit the real .env file with active credentials to source control.
# ============================================================================

# --- SERVER & DATABASE CONFIGURATION ---
PORT=8080
# For local development with H2 (Default out-of-the-box, no MySQL server needed):
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/pricehunt;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=MySQL
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# For MySQL 8.0+ production/local instance:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pricehunt_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password

# --- JWT SECURITY SETTINGS ---
PRICEHUNT_JWT_SECRET=9a3f2c4e6b8a1d0f5e7c3b9a2d4f6e8a1c0b3d5e7f9a2b4c6d8e0f1a3b5c7d9e
PRICEHUNT_JWT_EXPIRATION_MS=86400000

# --- MARKETPLACE 1: AMAZON INDIA (CREATORS API / PARTNER API) ---
# Eligibility: Active Amazon Associates account in India + 3 qualifying sales within 180 days
AMAZON_INTEGRATION_ENABLED=true
AMAZON_ACCESS_KEY=your_amazon_creators_access_key
AMAZON_SECRET_KEY=your_amazon_creators_secret_key
AMAZON_ASSOCIATE_TAG=your_associate_tag-21
AMAZON_REGION=eu-west-1
AMAZON_HOST=webservices.amazon.in

# --- MARKETPLACE 2: FLIPKART (DEVELOPER / AFFILIATE API) ---
# Eligibility: Registered Flipkart Affiliate account with written commercial agreement for price comparison
FLIPKART_INTEGRATION_ENABLED=true
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token
FLIPKART_BASE_URL=https://affiliate-api.flipkart.net/affiliate/1.0

# --- MARKETPLACE 3: CROMA (INFINITI RETAIL B2B INVENTORY FEED) ---
# Eligibility: Enterprise commercial contract with Infiniti Retail Ltd (Tata Group)
CROMA_INTEGRATION_ENABLED=true
CROMA_PARTNER_API_KEY=your_croma_b2b_api_key
CROMA_FEED_ENDPOINT=https://api.croma.com/v1/catalog

# --- MARKETPLACE 4: RELIANCE DIGITAL (RELIANCE RETAIL B2B FEED) ---
# Eligibility: Authorized B2B vendor onboarding with Reliance Retail Ltd
RELIANCE_INTEGRATION_ENABLED=true
RELIANCE_API_CLIENT_ID=your_reliance_client_id
RELIANCE_API_CLIENT_SECRET=your_reliance_client_secret

# --- AUTOMATED 24-HOUR PRICE TRACKING SCHEDULER ---
PRICEHUNT_TRACKING_SCHEDULED_CRON=0 0 2 * * ?
PRICEHUNT_TRACKING_INTERVAL_MS=86400000

